apps/ios/ZunaKit/Frameworks/
apps/ios/ZunaKit/Sources/ZunaCrypto/Generated/
apps/ios/ZunaKit/Sources/CSQLite/
apps/ios/ZunaKit/Sources/ZunaHost/Resources/zuna-core.js
apps/ios/ZunaKit/Sources/ZunaHost/Resources/zuna-highlight.js
apps/ios/ZunaKit/Sources/ZunaHost/Resources/zuna-password.js
apps/ios/ZunaKit/.build/
apps/ios/ZunaKit/.swiftpm/
apps/ios/*.xcodeproj/
apps/ios/build/
apps/ios/.e2e/

