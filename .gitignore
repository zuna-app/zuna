node_modules/
dist/
*.log
.DS_Store

# Signing keys and certificates, which live in a keychain or a password manager, never here
*.p12
*.pfx
*.p8
*.cer
*.certSigningRequest

# Build output
crypto/target/
crypto/bindgen/target/
apps/desktop/.deps/
packages/crypto/pkg/

# iOS: generated by scripts/build-crypto-apple.mjs, scripts/fetch-sqlite.mjs
# and apps/ios/core-bundle/build.mjs, or by Xcode and XcodeGen
apps/ios/ZunaKit/Frameworks/
apps/ios/ZunaKit/Sources/ZunaCrypto/Generated/
apps/ios/ZunaKit/Sources/CSQLite/
apps/ios/ZunaKit/Sources/ZunaHost/Resources/zuna-core.js
apps/ios/ZunaKit/Sources/ZunaHost/Resources/zuna-highlight.js
apps/ios/ZunaKit/Sources/ZunaHost/Resources/zuna-password.js
apps/ios/ZunaKit/.build/
apps/ios/ZunaKit/.swiftpm/
apps/ios/*.xcodeproj/
apps/ios/build/
apps/ios/.e2e/

# Local data
.dev-data/
.dev-data-removing-*/
# A bot's keys, where zuna-bot puts them unless told otherwise
zuna-bot-data/
*.db
*.db-shm
*.db-wal

# Editors
.vscode/
.idea/

# Local tool configuration
.claude/

# zuna-web: scripts/build-web.mjs copies the built app here to build it in
server/cmd/zuna-web/site/*
!server/cmd/zuna-web/site/.gitkeep

# Windows app (apps/desktop): its build, and the core bundle core-bundle/build.mjs writes
apps/desktop/target/
apps/desktop/assets/core/
