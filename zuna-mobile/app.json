{
  "expo": {
    "name": "Zuna",
    "slug": "zuna",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "minimal",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "buildNumber": "5",
      "supportsTablet": true,
      "bundleIdentifier": "chat.zuna.mobile",
      "appleTeamId": "SGKB9R23YT",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(CFBundleIdentifier)",
          "SGKB9R23YT.chat.zuna.mobile",
          "$(AppIdentifierPrefix)SGKB9R23YT.chat.zuna.mobile"
        ],
        "aps-environment": "development"
      },
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Zuna requires access to the local network to download and import your vault from other devices",
        "NSCameraUsageDescription": "Zuna requires access to the camera to scan QR codes for vault import and sending photos in chats",
        "NSPhotoLibraryUsageDescription": "Zuna requires access to the photo library to select and send photos in chat",
        "NSBonjourServices": [
          "_http._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "chat.zuna.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      "./plugins/withSelfSignedTLS",
      "./plugins/withNotificationServiceExtension"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
