{
  "name": "zuna",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Self-hosted, end-to-end encrypted chat with a modern interface.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/*"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "build:crypto": "node scripts/build-crypto.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:screenshare": "node scripts/build-screenshare.mjs",
    "build:windows": "node scripts/windows-app.mjs build",
    "dist:windows": "node scripts/windows-app.mjs dist",
    "install:windows": "node scripts/windows-app.mjs install",
    "dev:windows": "node scripts/windows-app.mjs run",
    "build:linux": "node scripts/linux-app.mjs build",
    "dist:linux": "node scripts/linux-app.mjs dist",
    "dev:linux": "node scripts/linux-app.mjs run",
    "build:macos": "node scripts/macos-app.mjs build",
    "dist:macos": "node scripts/macos-app.mjs dist",
    "dev:macos": "node scripts/macos-app.mjs run",
    "test": "npm run test:crypto && npm run test:server && npm run test:core",
    "test:crypto": "node scripts/test-crypto.mjs",
    "test:server": "node scripts/test-server.mjs",
    "test:core": "npm run test -w @zuna/core",
    "typecheck": "npm run typecheck -w @zuna/core && npm run typecheck -w @zuna/ui && npm run typecheck -w @zuna/web && npm run typecheck -w @zuna/site && npm run typecheck -w @zuna/ios && npm run typecheck -w @zuna/e2e",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:web": "node scripts/dev-web.mjs",
    "dev:clean": "node scripts/dev-clean.mjs",
    "test:ios": "npm run test -w @zuna/e2e",
    "build:ios": "node scripts/build-crypto-apple.mjs && node scripts/fetch-sqlite.mjs && npm run build:core -w @zuna/ios",
    "test:ios:sim": "ZUNA_E2E_TARGET=simulator npm run test -w @zuna/e2e",
    "test:ios:perf": "ZUNA_PERF=1 npm run test -w @zuna/e2e -- test/performance.test.ts",
    "test:ios:ui": "vite-node tests/e2e/src/ui-run.ts --",
    "test:ios:voice": "vite-node tests/e2e/src/voice-run.ts --",
    "test:ios:notify": "vite-node tests/e2e/src/notify-run.ts --",
    "test:ios:release": "node scripts/check-ios-release.mjs",
    "test:ios:check": "node scripts/check-ios.mjs",
    "test:ios:all": "npm test && npm run test:ios:check && npm run test:ios && npm run test:ios:sim && npm run test:ios:ui && npm run test:ios:release"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "app-builder-lib": "26.18.0",
    "vite-node": "^6.0.0"
  }
}
