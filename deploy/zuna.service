[Unit]
Description=Zuna chat server
After=network-online.target
Wants=network-online.target

[Service]
User=zuna
Group=zuna
ExecStart=/usr/local/bin/zuna-server
EnvironmentFile=/etc/zuna/zuna.env
Restart=on-failure
RestartSec=3
# Lets the unprivileged service bind ports 80 and 443 for automatic HTTPS.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
ReadWritePaths=/var/lib/zuna

[Install]
WantedBy=multi-user.target
