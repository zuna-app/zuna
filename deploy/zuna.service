[Unit]
Description=Zuna chat server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=zuna
Group=zuna
ExecStart=/usr/local/bin/zuna-server
EnvironmentFile=/etc/zuna/zuna.env
Restart=on-failure
RestartSec=3
# Plain HTTP on an unprivileged port, behind a reverse proxy: no capabilities needed.
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/zuna

[Install]
WantedBy=multi-user.target
