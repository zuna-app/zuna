[Unit]
Description=Zuna chat server
After=network-online.target
Wants=network-online.target

[Service]
User=zuna
Group=zuna
ExecStart=/usr/local/bin/zuna-server
EnvironmentFile=/etc/zuna/zuna.env
Restart=on-failure
RestartSec=3
# Plain HTTP on an unprivileged port, behind a reverse proxy: no capabilities needed.
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
ReadWritePaths=/var/lib/zuna

[Install]
WantedBy=multi-user.target
