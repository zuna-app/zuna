diff --git a/zuna-protocol/logger/zaputil/zuna.go b/zuna-protocol/logger/zaputil/zuna.go
new file mode 100644
index 0000000..7b2f7c1
--- /dev/null
+++ b/zuna-protocol/logger/zaputil/zuna.go
@@ -0,0 +1,349 @@
+// Zuna: every field and message of LiveKit's log passes through zunaEncoder, which lets
+// through only what's on a list, so that the log says nothing of who was in which room, from
+// where or on what (docs/VOICE_LOGS_PLAN.md in Zuna's repository). A field a later LiveKit adds
+// is dropped until someone decides it may stay.
+
+package zaputil
+
+import (
+	"net/netip"
+	"reflect"
+	"strings"
+	"time"
+
+	"go.uber.org/zap/buffer"
+	"go.uber.org/zap/zapcore"
+)
+
+// zunaKeys is what may stay: LiveKit's own IDs, made up for each session, so that one
+// session's lines can still be told from another's, and what says how a session went. A key
+// can mean two things in two places, so each was read in all of its uses before it was listed.
+// The room's and the participant's names, which are a channel's and a person's, aren't.
+var zunaKeys = map[string]bool{
+	// LiveKit's IDs, and its node's.
+	"roomID": true, "participantID": true, "trackID": true, "connID": true,
+	"nodeID": true, "reqNodeID": true, "selectedNodeID": true, "topic": true,
+	// The server, as it starts.
+	"nodeIP": true, "version": true, "portHttp": true, "rtc.portTCP": true,
+	"portPrometheus": true, "portDebugHandler": true, "portWebTransport": true,
+	"advertiseInternalIP": true,
+	// How a session went.
+	"reason": true, "error": true, "err": true, "state": true, "transport": true,
+	"connectionType": true, "kind": true, "mime": true, "mid": true, "rid": true,
+	"label": true, "messageType": true, "remote": true, "relayed": true,
+	"reconnect": true, "reconnectReason": true, "closedByClient": true, "sendLeave": true,
+	"expectedToResume": true, "isExpectedToResume": true, "isMigrated": true,
+	"isReceiverAdded": true, "fromSdp": true, "adaptiveStream": true,
+	"nodeSelectionReason": true, "numParticipants": true, "load": true, "cost": true,
+	"direction": true, "layer": true, "priority": true, "payloadType": true,
+	"ssrc": true, "rtxSsrc": true, "offerId": true, "answerId": true,
+	"forwarderGeneration": true, "forwardersGeneration": true,
+	"numPacketsForwarded": true, "numPacketsDropped": true,
+	"pps": true, "ppsMode": true, "expected": true,
+	// How long it took.
+	"duration": true, "connectTime": true, "iceDuration": true, "joinDuration": true,
+	"sessionDuration": true, "timeout": true,
+	// A track's clock.
+	"adjustment": true, "firstTimeAdjustment": true, "before": true, "after": true,
+	"startTime": true, "nowTime": true, "extStartTS": true, "extNowTS": true,
+	"samplesDiff": true, "samplesDuration": true, "timeSinceFirst": true,
+	"timeSinceReceive": true, "tsOffset": true,
+}
+
+// ZunaListed says whether a key may stay, for the patch's test in cmd/server.
+func ZunaListed(key string) bool { return zunaKeys[key] }
+
+// zunaVerbatim is what stays as it is: the address LiveKit found for itself as it starts,
+// which docs/LINUX.md tells a server's admins to read there.
+var zunaVerbatim = map[string]bool{"nodeIP": true}
+
+// zunaEncoder lets fields through to inner only if their keys are listed, and only plain
+// values: numbers, booleans, times, durations, strings and errors, and named types of those.
+// Objects, arrays, bytes and namespaces are dropped. Text is cleaned by zunaScrub.
+//
+// inner is a named field, not embedded, so a method zap adds later breaks the build instead
+// of passing through. It must not implement logger.SensitiveObjectEncoder.
+type zunaEncoder struct{ inner zapcore.Encoder }
+
+func (e zunaEncoder) Clone() zapcore.Encoder { return zunaEncoder{e.inner.Clone()} }
+
+func (e zunaEncoder) EncodeEntry(ent zapcore.Entry, fields []zapcore.Field) (*buffer.Buffer, error) {
+	ent.Message, ent.LoggerName = zunaScrub(ent.Message), zunaScrub(ent.LoggerName)
+	if len(fields) == 0 {
+		return e.inner.EncodeEntry(ent, nil)
+	}
+	c := zunaEncoder{e.inner.Clone()} // inner would add the fields to itself, past the filter
+	for i := range fields {
+		zunaAddTo(c, fields[i])
+	}
+	return c.inner.EncodeEntry(ent, nil)
+}
+
+// zunaAddTo adds a field as its AddTo would, but a Stringer only if it's a named type of a
+// plain kind, such as an enum. zap.Any makes anything with a String method one, a protobuf
+// message among them, whose String says all it holds, and an encoder is only given the text.
+// Every way a field comes to the encoder takes this: EncodeEntry, encoderWithValues and
+// zunaCore.With.
+func zunaAddTo(enc zapcore.ObjectEncoder, f zapcore.Field) {
+	if zunaKept(f) {
+		f.AddTo(enc)
+	}
+}
+
+func zunaKept(f zapcore.Field) bool {
+	return f.Type != zapcore.StringerType || f.Interface != nil && zunaPlainKind(reflect.ValueOf(f.Interface).Kind())
+}
+
+func zunaPlainKind(kind reflect.Kind) bool {
+	switch kind {
+	case reflect.Bool, reflect.String,
+		reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
+		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr,
+		reflect.Float32, reflect.Float64:
+		return true
+	}
+	return false
+}
+
+// zunaCore is the core every Encoder makes. It takes the fields With is given as the encoder
+// takes its own, which zap's core would add to its encoder by their AddTo.
+type zunaCore struct{ zapcore.Core }
+
+func (c zunaCore) With(fields []zapcore.Field) zapcore.Core {
+	kept := make([]zapcore.Field, 0, len(fields))
+	for _, f := range fields {
+		if zunaKept(f) {
+			kept = append(kept, f)
+		}
+	}
+	return zunaCore{c.Core.With(kept)}
+}
+
+func (zunaEncoder) AddArray(string, zapcore.ArrayMarshaler) error   { return nil }
+func (zunaEncoder) AddObject(string, zapcore.ObjectMarshaler) error { return nil }
+func (zunaEncoder) AddBinary(string, []byte)                        {}
+func (zunaEncoder) AddByteString(string, []byte)                    {}
+func (zunaEncoder) OpenNamespace(string)                            {}
+
+func (e zunaEncoder) AddBool(k string, v bool) {
+	if zunaKeys[k] {
+		e.inner.AddBool(k, v)
+	}
+}
+
+func (e zunaEncoder) AddComplex128(k string, v complex128) {
+	if zunaKeys[k] {
+		e.inner.AddComplex128(k, v)
+	}
+}
+
+func (e zunaEncoder) AddComplex64(k string, v complex64) {
+	if zunaKeys[k] {
+		e.inner.AddComplex64(k, v)
+	}
+}
+
+func (e zunaEncoder) AddDuration(k string, v time.Duration) {
+	if zunaKeys[k] {
+		e.inner.AddDuration(k, v)
+	}
+}
+
+func (e zunaEncoder) AddFloat64(k string, v float64) {
+	if zunaKeys[k] {
+		e.inner.AddFloat64(k, v)
+	}
+}
+
+func (e zunaEncoder) AddFloat32(k string, v float32) {
+	if zunaKeys[k] {
+		e.inner.AddFloat32(k, v)
+	}
+}
+
+func (e zunaEncoder) AddInt(k string, v int) {
+	if zunaKeys[k] {
+		e.inner.AddInt(k, v)
+	}
+}
+
+func (e zunaEncoder) AddInt64(k string, v int64) {
+	if zunaKeys[k] {
+		e.inner.AddInt64(k, v)
+	}
+}
+
+func (e zunaEncoder) AddInt32(k string, v int32) {
+	if zunaKeys[k] {
+		e.inner.AddInt32(k, v)
+	}
+}
+
+func (e zunaEncoder) AddInt16(k string, v int16) {
+	if zunaKeys[k] {
+		e.inner.AddInt16(k, v)
+	}
+}
+
+func (e zunaEncoder) AddInt8(k string, v int8) {
+	if zunaKeys[k] {
+		e.inner.AddInt8(k, v)
+	}
+}
+
+func (e zunaEncoder) AddString(k, v string) {
+	if !zunaKeys[k] {
+		return
+	}
+	if !zunaVerbatim[k] {
+		v = zunaScrub(v)
+	}
+	e.inner.AddString(k, v)
+}
+
+func (e zunaEncoder) AddTime(k string, v time.Time) {
+	if zunaKeys[k] {
+		e.inner.AddTime(k, v)
+	}
+}
+
+func (e zunaEncoder) AddUint(k string, v uint) {
+	if zunaKeys[k] {
+		e.inner.AddUint(k, v)
+	}
+}
+
+func (e zunaEncoder) AddUint64(k string, v uint64) {
+	if zunaKeys[k] {
+		e.inner.AddUint64(k, v)
