+package main
+
+// zunaPatch is the first 12 characters of the SHA-256 of Zuna's patch, which
+// deploy/livekit/build.sh sets, so that --version says which patch a binary was built with.
+// version.Version stays LiveKit's own, as it's what the server tells apps, and LiveKit's
+// JavaScript SDK compares it.
+var zunaPatch = "unknown"
diff --git a/cmd/server/zuna_log_test.go b/cmd/server/zuna_log_test.go
new file mode 100644
index 0000000..73c3a10
--- /dev/null
+++ b/cmd/server/zuna_log_test.go
@@ -0,0 +1,196 @@
+package main
+
+// Zuna: LiveKit's log, at debug, in both its formats, says nothing of who was in which room,
+// from where or on what, whichever way a line comes to it (docs/VOICE_LOGS_PLAN.md in Zuna's
+// repository).
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/livekit/protocol/livekit"
+	"github.com/livekit/protocol/logger"
+	"github.com/livekit/protocol/logger/pionlogger"
+	"github.com/livekit/protocol/logger/zaputil"
+
+	"github.com/livekit/livekit-server/pkg/config"
+	"github.com/livekit/livekit-server/pkg/service"
+)
+
+const (
+	// As Zuna's are: an account's ID and a device's, and a channel's.
+	zunaIdentity = "185a1be7a9cac9771c47cbd32f9c24e4.f80a33c0b1254125d9883e92ffd43b50"
+	zunaRoom     = "3941c28a574d47bc66a3df135bdfcb53"
+	zunaCaller   = "203.0.113.7"
+	zunaCaller6  = "2001:db8::7"
+	zunaLocal    = "192.168.1.20"
+	zunaSystem   = "Zuna Test System"
+	zunaModel    = "Zuna Test Board 9000"
+	// What LiveKit found for itself, which stays.
+	zunaServer = "198.51.100.1"
+)
+
+// What zap writes of an entry itself, beside its fields.
+var zunaEntryKeys = map[string]bool{"level": true, "ts": true, "logger": true, "caller": true, "msg": true, "stacktrace": true}
+
+// An error that says more with %+v, as github.com/pkg/errors' do.
+type zunaVerboseError struct{}
+
+func (zunaVerboseError) Error() string { return "dial failed" }
+func (zunaVerboseError) Format(s fmt.State, verb rune) {
+	fmt.Fprintf(s, "dial %s for %s failed", zunaCaller, zunaIdentity)
+}
+
+// An error made of others, as go.uber.org/multierr's are.
+type zunaErrorGroup struct{}
+
+func (zunaErrorGroup) Error() string { return "several failed" }
+func (zunaErrorGroup) Errors() []error {
+	return []error{errors.New("from " + zunaCaller), errors.New("for " + zunaIdentity)}
+}
+
+func zunaLogEverything(t *testing.T) {
+	clientInfo := &livekit.ClientInfo{Os: zunaSystem, DeviceModel: zunaModel, Address: zunaCaller}
+	identity := livekit.ParticipantIdentity(zunaIdentity)
+
+	// Fields, as Infow and the rest give them: listed and not, plain and not.
+	logger.Infow("participant active from "+zunaCaller+":51234 and ["+zunaCaller6+"]:443 in "+zunaRoom,
+		"participant", identity,
+		"room", livekit.RoomName(zunaRoom),
+		"participantID", livekit.ParticipantID("PA_zunatest"),
+		"roomID", livekit.RoomID("RM_zunatest"),
+		"trackID", livekit.TrackID("TR_zunatest"),
+		"clientInfo", clientInfo,
+		"participantInit", map[string]any{"Identity": zunaIdentity, "Client": clientInfo},
+		"publisherCandidates", []string{"udp4 host " + zunaLocal + ":7882", "udp4 srflx " + zunaCaller + ":51234"},
+		"candidate", "candidate:951112339 1 udp 2122260223 "+zunaLocal+" 50694 typ host",
+		"country", "NL",
+		"unlisted", "anything at all",
+		"connectionType", "udp to "+zunaCaller,
+		"reason", livekit.DisconnectReason_CLIENT_INITIATED,
+		"error", errors.New("read udp 127.0.0.1:7882->"+zunaCaller+":51234: refused"),
+		// A listed key with what isn't plain.
+		"state", clientInfo,
+		"kind", []byte(zunaIdentity),
+	)
+	logger.Infow("starting LiveKit server", "nodeIP", zunaServer, "portHttp", 7880, "version", "1.13.11")
+
+	// WithValues, which encodes into a copy of the encoder at once.
+	participant := logger.GetLogger().WithValues("participant", identity, "participantID", livekit.ParticipantID("PA_zunatest"), "clientInfo", clientInfo, "state", clientInfo, "remote", false)
+	participant.Debugw("with values", "kind", "audio")
+
+	// WithUnlikelyValues and WithDeferredValues, which come by way of Write.
+	logger.GetLogger().WithUnlikelyValues("participant", identity, "room", zunaRoom).Infow("unlikely", "participantID", "PA_zunatest")
+	deferred, resolve := logger.GetLogger().WithDeferredValues()
+	deferred.Infow("deferred", "participantID", "PA_zunatest")
+	resolve.Resolve("participant", identity, "candidate", zunaCaller)
+
+	// Errors, with what zap adds beside them.
+	logger.Warnw("could not connect", zunaVerboseError{}, "participantID", "PA_zunatest")
+	logger.Errorw("could not connect", zunaErrorGroup{}, "participantID", "PA_zunatest")
+
+	// slog and the standard log package, which InitFromConfig points at this logger, and
+	// net/http's errors, which LiveKit sets no ErrorLog for, with them.
+	slog.Info("slog from "+zunaCaller, "participant", zunaIdentity, "participantID", "PA_zunatest", slog.Group("client", "os", zunaSystem, "model", zunaModel))
+	// slog.With, which comes by way of the core's With.
+	slog.With("participant", zunaIdentity, "state", clientInfo, "reason", zunaCaller).Warn("slog with", "participantID", "PA_zunatest")
+	log.Printf("http: TLS handshake error from %s:51234: EOF", zunaCaller)
+
+	// pion's messages, formatted into their text.
+	pion := pionlogger.NewLoggerFactory(logger.GetLogger()).NewLogger("ice")
+	pion.Debugf("ping STUN from udp4 host %s:7882 to udp4 prflx %s:51234 for %s", zunaLocal, zunaCaller, zunaIdentity)
+	pion.Warnf("failed to resolve %s", zunaCaller6)
+
+	// A panic in a request, which negroni's recovery printed straight to stdout.
+	conf, err := config.NewConfig("", true, nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	handler := service.NewHTTPHandler(conf, nil, http.HandlerFunc(func(http.ResponseWriter, *http.Request) {
+		panic("serving " + zunaIdentity + " at " + zunaCaller)
+	}), nil)
+	request := httptest.NewRequest("GET", "/rtc/validate", nil)
+	request.RemoteAddr = zunaCaller + ":51234"
+	handler.ServeHTTP(httptest.NewRecorder(), request)
+}
+
+func TestZunaLogSaysNothingOfAnyone(t *testing.T) {
+	// Where the logger writes, which it takes as it starts.
+	read, write, err := os.Pipe()
+	if err != nil {
+		t.Fatal(err)
+	}
+	stdout, stderr := os.Stdout, os.Stderr
+	os.Stdout, os.Stderr = write, write
+	captured := make(chan string)
+	go func() {
+		all, _ := io.ReadAll(read)
+		captured <- string(all)
+	}()
+	for _, asJSON := range []bool{true, false} {
+		config.InitLoggerFromConfig(&config.LoggingConfig{Config: logger.Config{Level: "debug", JSON: asJSON}})
+		zunaLogEverything(t)
+	}
+	os.Stdout, os.Stderr = stdout, stderr
+	write.Close()
+	output := <-captured
+	if testing.Verbose() {
+		t.Log(output)
+	}
+
+	for _, forbidden := range []string{zunaIdentity, zunaRoom, "185a1be7a9cac9771c47cbd32f9c24e4", "f80a33c0b1254125d9883e92ffd43b50", zunaCaller, zunaCaller6, zunaLocal, zunaSystem, zunaModel, "candidate:", "typ host", "anything at all"} {
+		if strings.Contains(output, forbidden) {
+			t.Errorf("the log has %q", forbidden)
+		}
+	}
+	lines, withParticipant := 0, 0
+	scanner := bufio.NewScanner(strings.NewReader(output))
+	scanner.Buffer(make([]byte, 1<<20), 1<<20)
+	for scanner.Scan() {
+		line := scanner.Text()
+		fields := map[string]any{}
+		entryKeys := zunaEntryKeys
+		switch {
+		case strings.HasPrefix(line, "{"):
+			if err := json.Unmarshal([]byte(line), &fields); err != nil {
+				t.Fatalf("not JSON: %q", line)
+			}
+		case strings.Contains(line, "\t{"):
+			// The console's: time, level, logger, caller and message, then the fields as JSON.
+			if err := json.Unmarshal([]byte(line[strings.Index(line, "\t{")+1:]), &fields); err != nil {
+				t.Fatalf("no fields in JSON: %q", line)
+			}
+			entryKeys = nil
+		default:
+			// A line of a stack trace, or a console line without fields.
+			continue
+		}
+		lines++
+		for key := range fields {
+			if !entryKeys[key] && !zaputil.ZunaListed(key) {
+				t.Errorf("%q isn't on the list, in %q", key, line)
+			}
+		}
+		if fields["participantID"] == "PA_zunatest" {
+			withParticipant++
+		}
+	}
+	if withParticipant < 10 {
+		t.Fatalf("participantID came through %d times in %d lines with fields, so this checked nothing:\n%s", withParticipant, lines, output)
+	}
+	for _, kept := range []string{zunaServer, "127.0.0.1:7882", "PA_zunatest", "RM_zunatest", "TR_zunatest", "CLIENT_INITIATED", "<address>", "<id>"} {
+		if !strings.Contains(output, kept) {
+			t.Errorf("the log lost %q:\n%s", kept, output)
+		}
+	}
+}
