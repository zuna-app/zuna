+
+// AddReflected is where zap.Any sends what it has no case for, such as a named type of a
+// string or a number, which is told by its kind. Anything else is dropped.
+func (e zunaEncoder) AddReflected(k string, v any) error {
+	if !zunaKeys[k] || v == nil {
+		return nil
+	}
+	value := reflect.ValueOf(v)
+	switch value.Kind() {
+	case reflect.Bool:
+		e.AddBool(k, value.Bool())
+	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64:
+		e.AddInt64(k, value.Int())
+	case reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64, reflect.Uintptr:
+		e.AddUint64(k, value.Uint())
+	case reflect.Float32, reflect.Float64:
+		e.AddFloat64(k, value.Float())
+	case reflect.String:
+		e.AddString(k, value.String())
+	}
+	return nil
+}
+
+// zunaScrub takes every IP address out of text, with its port, but loopback and unspecified
+// ones, and every run of 32 or more hex digits, which is what Zuna's account, device and
+// channel IDs look like, in a room's name or a participant's identity. Addresses are found by
+// asking netip about each run of the characters they're made of, as a pattern would take
+// clock times and version numbers for them.
+func zunaScrub(text string) string {
+	var out strings.Builder
+	for i := 0; i < len(text); {
+		if !zunaInAddress(text[i]) {
+			out.WriteByte(text[i])
+			i++
+			continue
+		}
+		end := i
+		for end < len(text) && zunaInAddress(text[end]) {
+			end++
+		}
+		out.WriteString(zunaScrubRun(text[i:end]))
+		i = end
+	}
+	return out.String()
+}
+
+func zunaInAddress(c byte) bool {
+	return c >= '0' && c <= '9' || c >= 'a' && c <= 'f' || c >= 'A' && c <= 'F' || c == '.' || c == ':'
+}
+
+// zunaScrubRun takes a run of hex digits, dots and colons, which a sentence's punctuation may
+// begin or end, as in "from 203.0.113.7:51234: EOF". The whole run is tried first, as "::1"
+// and "2001:db8::" begin or end with what they're made of.
+func zunaScrubRun(run string) string {
+	starts := []int{0, len(run) - len(strings.TrimLeft(run, ".:"))}
+	ends := []int{len(run), len(strings.TrimRight(run, ".:"))}
+	for _, start := range starts {
+		for _, end := range ends {
+			if start >= end {
+				continue
+			}
+			if address, ok := zunaAddress(run[start:end]); ok {
+				if address.IsLoopback() || address.IsUnspecified() {
+					return run
+				}
+				return run[:start] + "<address>" + run[end:]
+			}
+		}
+	}
+	return zunaLongHex(run)
+}
+
+func zunaAddress(text string) (netip.Addr, bool) {
+	if address, err := netip.ParseAddr(text); err == nil {
+		return address, true
+	}
+	if both, err := netip.ParseAddrPort(text); err == nil {
+		return both.Addr(), true
+	}
+	return netip.Addr{}, false
+}
+
+// zunaLongHex replaces each part of a run, between its dots and colons, of 32 or more hex
+// digits.
+func zunaLongHex(run string) string {
+	var out strings.Builder
+	for i := 0; i < len(run); {
+		if run[i] == '.' || run[i] == ':' {
+			out.WriteByte(run[i])
+			i++
+			continue
+		}
+		end := i
+		for end < len(run) && run[end] != '.' && run[end] != ':' {
+			end++
+		}
+		if end-i >= 32 {
+			out.WriteString("<id>")
+		} else {
+			out.WriteString(run[i:end])
+		}
+		i = end
+	}
+	return out.String()
+}
