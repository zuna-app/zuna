+// Zuna: a panic in a request goes to the log, and through its filter, where negroni's
+// recovery would print it straight to stdout.
+
+package service
+
+import (
+	"fmt"
+
+	"github.com/urfave/negroni/v3"
+
+	"github.com/livekit/protocol/logger"
+)
+
+func zunaRecovery() *negroni.Recovery {
+	recovery := negroni.NewRecovery()
+	recovery.Logger = zunaPanicLog{}
+	return recovery
+}
+
+type zunaPanicLog struct{}
+
+func (zunaPanicLog) Println(v ...any)               { logger.Errorw(fmt.Sprint(v...), nil) }
+func (zunaPanicLog) Printf(format string, v ...any) { logger.Errorw(fmt.Sprintf(format, v...), nil) }
