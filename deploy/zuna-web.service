[Unit]
Description=Zuna web app
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=true
ExecStart=/usr/local/bin/zuna-web
# Such as ZUNA_WEB_LISTEN=127.0.0.1:8081, ZUNA_WEB_TRUST_PROXY=true and ZUNA_WEB_SERVER.
EnvironmentFile=/etc/zuna/zuna-web.env
Restart=on-failure
RestartSec=3
# Plain HTTP on an unprivileged port, behind a reverse proxy. It keeps nothing on disk.
CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
